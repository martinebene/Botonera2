[Unit]
Description=Botonera2 - bridge de dispositivos
After=network.target botonera2-backend.service
Requires=botonera2-backend.service

[Service]
Type=simple
User=botonera2-bridge
Group=botonera2-bridge
SupplementaryGroups=input
WorkingDirectory=/opt/botonera2
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/env /opt/botonera2/current/.venv/bin/botonera2-device-bridge --config /opt/botonera2/config/bridge/devices.json --url http://127.0.0.1:8000 --control-host 127.0.0.1 --control-port 8765
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
