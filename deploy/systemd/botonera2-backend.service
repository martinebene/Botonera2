[Unit]
Description=Botonera2 - backend institucional
After=network.target

[Service]
Type=simple
User=botonera2-backend
Group=botonera2-backend
WorkingDirectory=/opt/botonera2
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/env /opt/botonera2/current/.venv/bin/uvicorn botonera2_backend.main:app --app-dir /opt/botonera2/current/app/apps/backend/src --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
